# LubriExpert AI — Environment Configuration
# Use this template for local .env or configure these variables in your deployment platform

# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Frontend URL (for CORS) ─────────────────────────────
# Set this to your public frontend URL (e.g. https://your-domain.com)
# Supports comma-separated URLs (e.g. https://domain.com,https://www.domain.com) or '*'
FRONTEND_URL=https://your-frontend-domain.com

# ─── AI Provider (Gemini via OpenAI-compatible API) ─────
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Your Gemini API key — REQUIRED on the backend server environment only
# Get your key at: https://aistudio.google.com/
# NEVER commit or expose this key in the frontend!
AI_API_KEY=your_gemini_api_key_here

